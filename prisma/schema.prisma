// AI AFFILIATE ENGINE DATABASE SCHEMA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  category           String
  price              Float
  commission         Float
  commissionAmount   Float
  affiliatePlatform  String
  affiliateLink      String
  imageUrl           String?
  description        String?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  links              Link[]
  contents           Content[]
  scheduledPosts     ScheduledPost[]
  videoPrompts       VideoPrompt[]
  imagePrompts       ImagePrompt[]
  productionPackages ProductionPackage[]
  affiliateLinkTracking AffiliateLinkTracking[]

  @@index([status])
  @@index([category])
  @@index([affiliatePlatform])
}

model Link {
  id            String     @id @default(cuid())
  slug          String     @unique
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  originalLink  String
  clicks        Int        @default(0)
  uniqueClicks  Int        @default(0)
  lastClickedAt DateTime?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  clickLogs     ClickLog[]

  @@index([slug])
  @@index([productId])
  @@index([status])
}

model ClickLog {
  id          String   @id @default(cuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id])
  ipAddress   String?
  userAgent   String?
  source      String   @default("DIRECT")
  utmCampaign String?
  clickedAt   DateTime @default(now())

  @@index([clickedAt])
}

model Content {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  contentType        String
  platform           String
  status             String              @default("DRAFT")
  hook               String?
  caption            String?
  script             String?
  hashtags           String?
  cta                String?
  telegramText       String?
  whatsappText       String?
  tone               String              @default("casual")
  language           String              @default("id")
  approvalStatus     String              @default("PENDING")
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  scheduledPosts     ScheduledPost[]
  approvalLogs       ApprovalLog[]
  contentVariants    ContentVariant[]
  videoPrompts       VideoPrompt[]
  imagePrompts       ImagePrompt[]
  qualityScores      QualityScore[]
  productionPackages ProductionPackage[]
  affiliateLinkTracking AffiliateLinkTracking[]

  @@index([approvalStatus])
  @@index([platform])
}

model ApprovalLog {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id])
  action    String
  actionAt  DateTime @default(now())
  notes     String?
}

model ScheduledPost {
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  id          String    @id @default(cuid())
  contentId   String
  content     Content   @relation(fields: [contentId], references: [id])
  platform    String
  scheduledAt DateTime
  postedAt    DateTime?
  status      String    @default("SCHEDULED")
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([scheduledAt])
}

// ============================================
// CONTENT CALENDAR AUTOMATION
// ============================================

model PostingSchedule {
  id          String   @id @default(cuid())
  brandId     String?
  platform    String   // TIKTOK, INSTAGRAM, FACEBOOK
  dayOfWeek   Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  hour        Int      // 0-23
  minute      Int      // 0-59
  contentType String   // IMAGE, CAROUSEL, VIDEO
  maxPosts    Int      @default(1) // Max posts per slot
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform])
  @@index([dayOfWeek])
  @@index([isActive])
}

model ContentQueue {
  id           String    @id @default(cuid())
  brandId      String?
  contentId    String
  distributionId String? // Links to DistributionQueue
  contentType  String    // IMAGE, CAROUSEL, VIDEO
  platform     String
  priority     Int       @default(0) // Higher = more priority
  status       String    @default("PENDING") // PENDING, SCHEDULED, POSTED, SKIPPED
  scheduledFor DateTime? // When to schedule in Zernio
  postedAt     DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([brandId])
}

model ContentVariant {
  id           String   @id @default(cuid())
  contentId    String
  content      Content  @relation(fields: [contentId], references: [id])
  variantType  String
  variantIndex Int
  contentValue String
  createdAt    DateTime @default(now())

  @@index([contentId])
  @@index([variantType])
}

model VideoPrompt {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id])
  tool      String
  prompt    String
  duration  Int?
  format    String?
  hook      String?
  voiceOver String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())

  @@index([tool])
  @@index([status])
}

model ImagePrompt {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  contentId  String?
  content    Content? @relation(fields: [contentId], references: [id])
  imageType  String
  prompt     String
  layout     String?
  background String?
  visualMood String?
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())

  @@index([imageType])
  @@index([status])
}

model QualityScore {
  id           String   @id @default(cuid())
  contentId    String
  content      Content  @relation(fields: [contentId], references: [id])
  hookScore    Int      @default(0)
  overallScore Int      @default(0)
  bestPlatform String?
  bestHook String?
  bestCaption String?
  bestCta String?
  clarityScore Int?
  conversionScore Int?
  platformFitScore Int?
  recommendation String?
  shouldPost   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([overallScore])
}

model ProductionPackage {
  id                   String      @id @default(cuid())
  contentId            String
  content              Content     @relation(fields: [contentId], references: [id])
  productId            String
  product              Product     @relation(fields: [productId], references: [id])
  status               String      @default("draft")
  bestPlatform         String?
  overallScore         Int         @default(0)
  videoPromptPippit    String?
  videoPromptVeo       String?
  videoPromptSeedance  String?
  videoPromptSora      String?
  imagePromptThumbnail String?
  imagePromptSocial    String?
  imagePromptCarousel  String?
  imagePromptAd        String?
  voiceoverScript      String?
  subtitleScript       String?
  exportedAt           DateTime?
  renderedAt           DateTime?
  errorMessage         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  renderJobs           RenderJob[]

  @@index([status])
}

model RenderJob {
  id                  String            @id @default(cuid())
  productionPackageId String
  productionPackage   ProductionPackage @relation(fields: [productionPackageId], references: [id])
  jobType             String
  tool                String
  status              String            @default("queued")
  prompt              String
  outputUrl           String?
  thumbnailUrl        String?
  duration            Int?
  format              String?
  size                String?
  providerJobId       String?
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  retryCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([tool])
}

model AssetFile {
  id             String    @id @default(cuid())
  productId      String?
  packageId      String?
  renderJobId    String?
  fileType       String
  fileName       String
  provider       String              // Render provider: PIPPIT, VEO, DALL_E, etc.
  cloudProvider  String?             // Storage provider: GOOGLE_DRIVE, DROPBOX, LOCAL
  cloudUrl       String?
  cloudFileId    String?
  cloudFolderId  String?
  cloudPath      String?
  localPath      String?
  fileSize       BigInt?
  localSize      BigInt?
  localCachedAt  DateTime?
  uploadStatus   String    @default("pending")  // pending | uploading | uploaded | failed
  uploadRetryCount Int      @default(0)
  uploadError    String?
  contentHash    String?
  mimeType       String?
  uploadedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([productId])
  @@index([uploadStatus])
  @@index([cloudProvider])
  @@index([fileType])
}

model RateLimit {
  id          String   @id @default(cuid())
  platform    String   @unique
  dailyLimit  Int      @default(3)
  dailyUsed   Int      @default(0)
  lastResetAt DateTime @default(now())
}

model Analytics {
  id          String   @id @default(cuid())
  period      String
  dateFrom    DateTime
  dateTo      DateTime
  totalClicks Int      @default(0)
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String    @unique
  expiresAt DateTime?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
}

model TelegramSession {
  id         String   @id @default(cuid())
  telegramId String   @unique
  username String?
  firstName String?
  lastName String?
  state      String   @default("START")
  stateData String?
  isAdmin    Boolean  @default(false)
  isApproved Boolean  @default(false)
  activeBrandId    String?
  activeBrandSlug  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([activeBrandId])
}

model WebhookLog {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ============================================
// PHASE 5: BRAND + ZERNIO DISTRIBUTION ENGINE
// ============================================

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, INACTIVE
  settings    String? // JSON for brand-specific settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  zernioConfigs     ZernioConfig[]
  socialAccounts    SocialAccount[]
  distributionQueue DistributionQueue[]
  affiliateLinkTracking AffiliateLinkTracking[]

  @@index([status])
  @@index([slug])
}

model ZernioConfig {
  id           String    @id @default(cuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id])
  name         String // e.g., "Zernio Key 1", "Zernio Key 2"
  apiKey       String
  accountLimit Int       @default(10) // Max accounts per key
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([brandId, name])
  @@index([brandId])
  @@index([isActive])
}

model SocialAccount {
  id              String    @id @default(cuid())
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id])
  platform        String // TIKTOK, INSTAGRAM, FACEBOOK, YOUTUBE
  accountId       String // Platform's account ID
  accountName     String // Display name
  accountUsername String? // @username
  avatarUrl       String?
  followers       Int       @default(0)
  status          String    @default("ACTIVE") // ACTIVE, PAUSED, INACTIVE
  dailyLimit      Int       @default(3) // Max posts per day
  dailyUsed       Int       @default(0) // Posts today
  cooldownMinutes Int       @default(60) // Min minutes between posts
  lastPostedAt    DateTime?
  priority        Int       @default(0) // Higher = more priority
  zernioConfigId  String? // Assigned Zernio config
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([brandId, platform, accountId])
  @@index([brandId])
  @@index([platform])
  @@index([status])
}

model DistributionQueue {
  id          String  @id @default(cuid())
  brandId     String
  brand       Brand   @relation(fields: [brandId], references: [id])
  assetFileId String? // Reference to AssetFile
  productId   String? // Reference to Product

  // Content
  videoUrl     String?
  thumbnailUrl String?
  caption      String?
  hashtags     String?
  script       String?
  voiceoverUrl String?

  // Metadata
  contentType String // VIDEO, IMAGE, CAROUSEL
  platform    String // TIKTOK, INSTAGRAM, FACEBOOK, YOUTUBE

  // Routing
  socialAccountId String? // Assigned social account
  zernioConfigId  String? // Zernio config used

  // Status
  status   String @default("DRAFT") // DRAFT, READY, QUEUED, POSTING, POSTED, FAILED, CANCELLED
  provider String // PIPPIT_MANUAL, HIGGSFIELD_AUTO, DALL_E, etc.

  // Scheduling
  scheduledAt DateTime?
  postedAt    DateTime?

  // Results
  postUrl  String? // URL of posted content
  postId   String? // Platform's post ID
  views    Int     @default(0)
  likes    Int     @default(0)
  comments Int     @default(0)
  shares   Int     @default(0)

  // Revenue Tracking
  clicks Int     @default(0)
  uniqueClicks  Int     @default(0)
  leads         Int     @default(0)
  sales         Int     @default(0)
  conversionRate Float @default(0)
  revenue Float   @default(0)
  commission     Float   @default(0)
  estimatedCommission Float @default(0)

  // Affiliate Link
  affiliateLink String?
  trackingLink   String?

  // Link Placement Strategy (platform-specific)
  linkPlacementType     String?  // BIO_LINK, STORY_STICKER, COMMENT, DIRECT, PINNED_COMMENT, BIO_PLUS_CTA, NO_LINK
  linkPlacementText     String?  // CTA text for caption (e.g., "Link ada di bio")
  bioLinkRequired        Boolean @default(false)
  manualActionRequired   Boolean @default(false)
  manualActionNote       String?  // Note for manual action (e.g., "Need to add story sticker")
  destinationUrl         String?  // Final destination URL
  pinnedCommentText      String?  // Text for pinned comment (YouTube)

  // Approval
  approvalStatus  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  affiliateLinkTracking AffiliateLinkTracking[]

  @@index([brandId])
  @@index([status])
  @@index([approvalStatus])
  @@index([scheduledAt])
  @@index([platform])
}

model PostingLog {
  id              String   @id @default(cuid())
  socialAccountId String
  distributionId  String
  platform        String
  status          String // SUCCESS, FAILED
  postUrl         String?
  errorMessage    String?
  postedAt        DateTime @default(now())

  @@index([socialAccountId])
  @@index([postedAt])
}

// ============================================
// REVENUE TRACKING MODELS
// ============================================

model RevenueEvent {
  id              String   @id @default(cuid())
  distributionId String
  brandId         String
  productId       String?

  // Event Type
  eventType       String   // CLICK, LEAD, SALE, COMMISSION_PAID
  eventDate       DateTime @default(now())

  // Values
  revenue Float    @default(0)
  commission      Float    @default(0)
  quantity Int      @default(1)

  // Attribution
  platform String?  // TIKTOK, INSTAGRAM, etc.
  socialAccountId String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  // Metadata
  ipAddress       String?
  userAgent       String?
  referer         String?
  country         String?
  device String?  // MOBILE, DESKTOP, TABLET

  createdAt       DateTime @default(now())

  @@index([distributionId])
  @@index([brandId])
  @@index([eventType])
  @@index([eventDate])
}

model RevenueSummary {
  id String   @id @default(cuid())
  brandId     String
  period String   // DAILY, WEEKLY, MONTHLY
  periodStart DateTime
  periodEnd   DateTime

  // Aggregates
  postsCount Int     @default(0)
  clicks          Int     @default(0)
  uniqueClicks    Int     @default(0)
  leads           Int     @default(0)
  sales           Int     @default(0)
  revenue         Float   @default(0)
  commission      Float   @default(0)
  estimatedCommission Float @default(0)

  // Platform breakdown (JSON)
  platformBreakdown String? // {"TIKTOK": {"clicks": 100, "revenue": 50}, ...}

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, period, periodStart])
  @@index([brandId])
  @@index([period])
}

model AffiliateProduct {
  id              String   @id @default(cuid())
  brandId         String
  productId       String   // Reference to Product
  affiliateLink String
  commissionRate  Float    @default(10) // Percentage
  commissionAmount Float   @default(0)
  cookieDuration  Int      @default(7) // Days
  status String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([brandId, productId])
  @@index([brandId])
}

// ============================================
// AFFILIATE LINK TRACKING SYSTEM
// Unified tracking from creation to conversion
// ============================================

model AffiliateLinkTracking {
  id            String   @id @default(cuid())

  // Core references
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])
  contentId       String?
  content         Content?  @relation(fields: [contentId], references: [id])
  distributionId  String?
  distribution    DistributionQueue? @relation(fields: [distributionId], references: [id])
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id])

  // Link information
  originalLink    String
  trackingLink    String?
  shortCode       String?  // Short URL slug for easy access
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  // Pipeline stage
  currentPipelineStage String @default("PRODUCT_CREATED")
  // Stages: PRODUCT_CREATED | CONTENT_GENERATED | APPROVED | DISTRIBUTED | POSTED | ACTIVE | PAUSED | EXPIRED

  // Pipeline history (JSON array of stage changes)
  pipelineHistory String @default("[]")
  // Format: [{"stage": "PRODUCT_CREATED", "timestamp": "2024-01-01T00:00:00Z", "note": "..."}]

  // Performance metrics (cumulative)
  clicks          Int     @default(0)
  uniqueClicks    Int     @default(0)
  leads           Int     @default(0)
  sales           Int     @default(0)
  revenue         Float   @default(0)
  commission      Float   @default(0)
  conversionRate  Float   @default(0)

  // Link metadata
  platform        String?  // TIKTOK, INSTAGRAM, etc.
  contentType     String?  // VIDEO, IMAGE, CAROUSEL
  provider        String?  // PIPPIT_MANUAL, HIGGSFIELD_AUTO, etc.
  postUrl         String?  // URL of posted content
  postId          String?  // Platform's post ID

  // Status
  status          String   @default("ACTIVE")  // ACTIVE, PAUSED, EXPIRED
  pausedAt        DateTime?
  expiredAt       DateTime?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastClickedAt   DateTime?

  // Event logs (for detailed tracking)
  eventLogs       LinkEventLog[]

  @@index([productId])
  @@index([contentId])
  @@index([distributionId])
  @@index([brandId])
  @@index([shortCode])
  @@index([currentPipelineStage])
  @@index([status])
  @@index([platform])
}

model LinkEventLog {
  id              String   @id @default(cuid())
  trackingId      String
  tracking        AffiliateLinkTracking @relation(fields: [trackingId], references: [id])
  
  // Event details
  eventType       String   // CLICK, LEAD, SALE, STAGE_CHANGE, STATUS_CHANGE
  eventDate       DateTime @default(now())
  
  // Values (for revenue events)
  revenue         Float    @default(0)
  commission      Float    @default(0)
  
  // Attribution
  ipAddress       String?
  userAgent       String?
  referer         String?
  country         String?
  device          String?  // MOBILE, DESKTOP, TABLET
  
  // Metadata
  metadata        String?  // JSON for extra data
  
  createdAt       DateTime @default(now())

  @@index([trackingId])
  @@index([eventType])
  @@index([eventDate])
}
