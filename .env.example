# ============================================
# AI AFFILIATE DISTRIBUTION ENGINE
# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN VALUES
# ============================================

PORT=3001
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL="file:./dev.db"
DATABASE_DIRECT_URL="file:./dev.db"

# Telegram
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID"

# AI Provider
AI_API_KEY="YOUR_AI_API_KEY"
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.koboillm.com/v1"

# Security
JWT_SECRET="YOUR_RANDOM_64_CHAR_SECRET"

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
DEBUG=false

# HiggsField
HF_KEY_ID="YOUR_HF_KEY_ID"
HF_KEY_SECRET="YOUR_HF_KEY_SECRET"

# Storage
STORAGE_PROVIDER=GOOGLE_DRIVE
LOCAL_TEMP_DIR=./tmp
AUTO_CLEANUP_LOCAL=true

# Google OAuth
GOOGLE_ACCESS_TOKEN=""
GOOGLE_REFRESH_TOKEN="YOUR_GOOGLE_REFRESH_TOKEN"
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Dropbox
DROPBOX_ACCESS_TOKEN=""

# Zernio
ZERNIO_API_URL=https://api.zernio.com/v1
ZERNIO_CEPAT_KEY_1="YOUR_ZERNIO_KEY"
ZERNIO_CEPAT_KEY_2="YOUR_ZERNIO_KEY"
ZERNIO_CRYPTO_KEY_1="YOUR_ZERNIO_KEY"
ZERNIO_CRYPTO_KEY_2="YOUR_ZERNIO_KEY"
ZERNIO_CRYPTO_KEY_3="YOUR_ZERNIO_KEY"
