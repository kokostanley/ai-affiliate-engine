# ============================================
# AI AFFILIATE DISTRIBUTION ENGINE
# ============================================
# Backend Configuration
PORT=3000
NODE_ENV=development

# ============================================
# SUPABASE DATABASE
# ============================================
# Connection string dari Supabase Dashboard
# Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Dapatkan dari https://supabase.com
# Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# TELEGRAM BOT
# ============================================
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
TELEGRAM_APPROVAL_CHAT_ID=your-approval-chat-id-here

# ============================================
# AI PROVIDER (OpenAI Compatible)
# ============================================
# OpenAI / OpenRouter / custom endpoint
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=2048

# ============================================
# BUFFER API (Placeholder)
# ============================================
# https://buffer.com/developers/api
BUFFER_CLIENT_ID=your-buffer-client-id
BUFFER_CLIENT_SECRET=your-buffer-client-secret
BUFFER_ACCESS_TOKEN=your-buffer-access-token
BUFFER_WEBHOOK_SECRET=your-buffer-webhook-secret

# ============================================
# META API / FACEBOOK (Placeholder)
# ============================================
# https://developers.facebook.com
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token

# ============================================
# GOOGLE SHEETS (Placeholder)
# ============================================
# Service Account JSON from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
GOOGLE_SHEETS_ID=your-google-sheets-id

# ============================================
# N8N WEBHOOK (Placeholder)
# ============================================
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/affiliate
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# ============================================
# RATE LIMITS (Safety Rules)
# ============================================
# Max posting per platform per day
RATE_LIMIT_TIKTOK=3
RATE_LIMIT_INSTAGRAM=3
RATE_LIMIT_FACEBOOK=5
RATE_LIMIT_YOUTUBE=2
RATE_LIMIT_TELEGRAM=5
RATE_LIMIT_WHATSAPP=3

# ============================================
# SESSION & SECURITY
# ============================================
SESSION_SECRET=your-super-secret-session-key-change-this
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# REDIS (Optional - untuk caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# LOGGING & DEBUG
# ============================================
LOG_LEVEL=info
DEBUG=false
