    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "env-var": "^7.5.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "grammy": "^1.43.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.7",
    "next": "^14.2.0",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.1.1",
    "node-telegram-bot-api": "^0.64.0",
    "openai": "^4.47.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "slugify": "^1.6.6",
