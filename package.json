{
  "name": "ai-affiliate-engine",
  "version": "1.0.0",
  "description": "AI Affiliate Distribution Engine - Sistem distribusi link affiliate otomatis dengan AI",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "dev:next": "next dev",
    "dev:worker": "tsx src/workers/scheduler.ts",
    "dev:render-worker": "tsx src/workers/render-worker.ts",
    "dev:bot": "tsx src/bot/index.ts",
    "dev:api": "tsx src/api-server.ts",
    "build": "next build && tsc -p tsconfig.api.json",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist/app/server.js",
    "start:bot": "node dist/bot/index.js",
    "start:worker": "node dist/workers/scheduler.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:brands": "tsx prisma/seed-brands.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs": "typedoc",
    "setup:google-drive": "tsx scripts/google-drive-oauth-setup.ts",
    "test:google-drive": "tsx scripts/test-google-drive.ts"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.1",
